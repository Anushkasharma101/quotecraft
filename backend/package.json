{
  "name": "quotecraft-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env seed.js",
    "test": "node --test tests/services.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "dependencies": {
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0"
  }
}
